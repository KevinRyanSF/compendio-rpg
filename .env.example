# Copie para .env e preencha. O .env nunca vai para o git.

# Provedor de LLM: gemini (padrão, tem uso gratuito no AI Studio) ou claude
COMPENDIO_PROVEDOR=gemini

# Chave do provedor escolhido (só precisa da que for usar)
#   Gemini: https://aistudio.google.com/apikey
#   Claude: https://console.anthropic.com  (cobrado à parte do plano do Claude)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (opcional — sem isso, usa os padrões do provedor em src/compendio/config.py)
#   rápido = extração em volume; forte = mapear o livro, descobrir esquemas, validar
#   vários separados por vírgula = reserva automática se o primeiro estiver sobrecarregado
# COMPENDIO_MODELO_RAPIDO=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# COMPENDIO_MODELO_FORTE=gemini-3.8-flash,gemini-3.6-flash

COMPENDIO_MAX_TOKENS=4096
# segundos esperando cada resposta da API
COMPENDIO_TIMEOUT=120
COMPENDIO_BANCO=data/compendio.db
